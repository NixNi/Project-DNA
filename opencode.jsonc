{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    // "./dist/src/index.js"
  ],
  "command": {
    "analyze-trace": {
      "template": "Analyze the session trace and conversation history. Identify candidate workflows, recurring calculations, or multi-step logic that should be crystallized into reusable LiveTools. Use the 'session-trace-tool-synthesizer' skill to formulate, register (via register_live_tool with explicit sampleInputs), and verify the new live tools.",
      "description": "Analyze session trace and synthesize reusable LiveTools"
    }
  }
}

